rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to safely check for admin role
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for user profiles
    match /users/{userId} {
      // Admins can manage any profile, and users can manage their own.
      allow read, write: if isAdmin() || request.auth.uid == userId;
    }

    // Rules for student data
    match /students/{studentId} {
        // Admins have full read/write access to all student records.
        allow read, write: if isAdmin();

        // A student can read and update their own data.
        // We match their exact authenticated UID against the `authUid` stored in the document.
        allow read, update: if 'authUid' in resource.data && resource.data.authUid == request.auth.uid;
    }

    // Rules for app settings
    match /settings/{document} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rules for activity logs
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
