rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to safely check for admin role
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for user profiles
    match /users/{userId} {
      // Admins can manage any profile, and users can manage their own.
      allow read, write: if isAdmin() || request.auth.uid == userId;
    }

    // Rules for student data
    match /students/{studentId} {
        // Admins have full read/write access to all student records.
        allow read, write: if isAdmin();

        // A student can read and update their own data.
        // We match their exact authenticated UID against the `authUid` stored in the document.
        allow read, update: if 'authUid' in resource.data && resource.data.authUid == request.auth.uid;
    }

    // Rules for app settings
    match /settings/{document} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rules for activity logs
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Rules for correction requests
    match /correction_requests/{requestId} {
      // Students can create and read their own requests
      allow create: if request.auth != null;
      allow read: if isAdmin() || (resource != null && resource.data.studentUid == request.auth.uid);
      // Only admins can update status or delete
      allow update, delete: if isAdmin();
    }

    // Rules for notifications
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Only admins can create and manage notifications
      allow write: if isAdmin();
    }

    // Rules for academic groups (batches, classes, semesters)
    match /academicGroups/{groupId} {
      // All authenticated users can read academic structure
      allow read: if request.auth != null;
      // Only admins can modify the academic structure
      allow write: if isAdmin();
    }
  }
}
