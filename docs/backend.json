{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique ID." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "URL of the user's profile picture." },
        "role": { "type": "string", "enum": ["admin", "student"], "description": "The user's role." },
        "phone": { "type": "string", "description": "The user's phone number." },
        "age": { "type": "number", "description": "The user's age." },
        "gender": { "type": "string", "enum": ["Male", "Female"], "description": "The user's gender." },
        "educationalBackground": { "type": "string", "description": "The user's educational background." }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores public user profile information."
    }
  }
}
